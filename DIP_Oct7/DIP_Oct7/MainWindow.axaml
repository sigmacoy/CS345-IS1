<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="960"
        x:Class="DIP_Oct7.MainWindow"
        Title="Philippine Peso Coin Counter - DIP"
        Width="1360" Height="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif">

    <DockPanel LastChildFill="True" Background="#141517">

        <!-- Top Header & Control Toolbar -->
        <Border DockPanel.Dock="Top" Background="#1B1C20" BorderBrush="#2C2E35" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel Spacing="12">

                <!-- Title & Subtitle Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Philippine Peso Coin Counter"
                                   FontFamily="'Playfair Display', 'Libre Baskerville', Georgia, 'Times New Roman', serif"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#F0F2F5"
                                   LetterSpacing="0.3"/>
                        <TextBlock Text="Digital image processing and denomination analysis"
                                   FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                   FontSize="12"
                                   Foreground="#8A8E98"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Active Filter / Mode Pill -->
                    <Border Grid.Column="1"
                            Background="#24262C"
                            BorderBrush="#353842"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActiveMode"
                                   Text="Mode: All Coins"
                                   FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#B0B5C0"/>
                    </Border>
                </Grid>

                <Border Height="1" Background="#26282E"/>

                <!-- Row 1: Primary Action Buttons -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

                    <!-- Load Image Button -->
                    <Button x:Name="BtnLoadImage"
                            Click="BtnLoadImage_Click"
                            Margin="0,0,8,0"
                            Padding="16,8"
                            Background="#344354"
                            Foreground="#F0F2F5"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="SemiBold"
                            FontSize="12"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="Load Image"/>
                    </Button>

                    <!-- Count Total Denomination Button -->
                    <Button x:Name="BtnCountCoins"
                            Click="BtnCountCoins_Click"
                            Margin="0,0,8,0"
                            Padding="16,8"
                            Background="#2B3747"
                            Foreground="#F0F2F5"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="SemiBold"
                            FontSize="12"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="Count the total denomination of the coins"/>
                    </Button>

                    <!-- Show Rectangular Shape & Nth Count Button -->
                    <Button x:Name="BtnShowRectangles"
                            Click="BtnShowRectangles_Click"
                            Margin="0,0,8,0"
                            Padding="16,8"
                            Background="#262E3B"
                            Foreground="#E2E6ED"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="SemiBold"
                            FontSize="12"
                            BorderBrush="#3D4A5E"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="Show Rectangles and Nth Count (Top-Left to Bottom-Right)"/>
                    </Button>

                    <!-- Show All Coins Button -->
                    <Button x:Name="BtnShowAll"
                            Click="BtnShowAll_Click"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Background="#24262C"
                            Foreground="#A6ACB8"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="Medium"
                            FontSize="12"
                            BorderBrush="#333640"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="Show All"/>
                    </Button>

                    <!-- Zoom Controls: Zoom: + - style -->
                    <Border Background="#202227"
                            BorderBrush="#31343E"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Zoom:"
                                       FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                       Foreground="#858994"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="BtnZoomIn"
                                    Click="BtnZoomIn_Click"
                                    Width="26" Height="26"
                                    Padding="0"
                                    Background="#272A32"
                                    Foreground="#D6DAE3"
                                    FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="#3D414D"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    ToolTip.Tip="Zoom In">
                                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="BtnZoomOut"
                                    Click="BtnZoomOut_Click"
                                    Width="26" Height="26"
                                    Padding="0"
                                    Background="#272A32"
                                    Foreground="#D6DAE3"
                                    FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="#3D414D"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    ToolTip.Tip="Zoom Out">
                                <TextBlock Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="BtnZoomReset"
                                    Click="BtnZoomReset_Click"
                                    Padding="6,2"
                                    Height="26"
                                    Background="#202227"
                                    Foreground="#8E93A0"
                                    FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    BorderBrush="#2D3039"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    ToolTip.Tip="Reset Zoom">
                                <TextBlock x:Name="TxtZoomLevel" Text="100%" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- Row 2: Denomination Filter Buttons -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

                    <TextBlock Text="Filter by denomination:"
                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                               Foreground="#858994"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,10,0"/>

                    <Button x:Name="Btn5Centavos"
                            Click="Btn5Centavos_Click"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            Background="#222429"
                            Foreground="#C8CCD4"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="Medium"
                            FontSize="12"
                            BorderBrush="#353842"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="5 cents"/>
                    </Button>

                    <Button x:Name="Btn10Centavos"
                            Click="Btn10Centavos_Click"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            Background="#222429"
                            Foreground="#C8CCD4"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="Medium"
                            FontSize="12"
                            BorderBrush="#353842"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="10 cents"/>
                    </Button>

                    <Button x:Name="Btn25Centavos"
                            Click="Btn25Centavos_Click"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            Background="#222429"
                            Foreground="#C8CCD4"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="Medium"
                            FontSize="12"
                            BorderBrush="#353842"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="25 cents"/>
                    </Button>

                    <Button x:Name="Btn1Peso"
                            Click="Btn1Peso_Click"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            Background="#222429"
                            Foreground="#C8CCD4"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="Medium"
                            FontSize="12"
                            BorderBrush="#353842"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="1 pesos"/>
                    </Button>

                    <Button x:Name="Btn5Pesos"
                            Click="Btn5Pesos_Click"
                            Margin="0,0,6,0"
                            Padding="12,6"
                            Background="#222429"
                            Foreground="#C8CCD4"
                            FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                            FontWeight="Medium"
                            FontSize="12"
                            BorderBrush="#353842"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand">
                        <TextBlock Text="5 pesos"/>
                    </Button>

                </WrapPanel>

            </StackPanel>
        </Border>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#17181B" BorderBrush="#26282E" BorderThickness="0,1,0,0" Padding="18,8">
            <TextBlock x:Name="TxtStatus"
                       Text="Ready."
                       FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                       Foreground="#858994"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Main Workspace -->
        <Grid ColumnDefinitions="*,330">

            <!-- Left: Viewport Area -->
            <Border Grid.Column="0" Background="#0F1012" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl x:Name="ViewportTransform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        </LayoutTransformControl.LayoutTransform>
                        <Grid x:Name="ViewportGrid" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image x:Name="ImgDisplay"
                                   Stretch="None"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                            <Canvas x:Name="OverlayCanvas"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"/>
                        </Grid>
                    </LayoutTransformControl>
                </ScrollViewer>
            </Border>

            <!-- Right: Summary Dashboard -->
            <Border Grid.Column="1" Background="#1A1B1F" BorderBrush="#2A2C32" BorderThickness="1,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">

                        <TextBlock Text="Denomination Summary"
                                   FontFamily="'Playfair Display', 'Libre Baskerville', Georgia, 'Times New Roman', serif"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F0F2F5"
                                   HorizontalAlignment="Left"/>

                        <Border Height="1" Background="#26282E"/>

                        <!-- 5 Cents Card -->
                        <Border Background="#202227" BorderBrush="#2F323A" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="5 cents (5c)"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#C5C9D3"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtCount5Centavos"
                                               Text="0 coins"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#7E838F"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="TxtValue5Centavos"
                                           Text="PHP 0.00"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#E0E3EB"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 10 Cents Card -->
                        <Border Background="#202227" BorderBrush="#2F323A" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="10 cents (10c)"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#C5C9D3"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtCount10Centavos"
                                               Text="0 coins"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#7E838F"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="TxtValue10Centavos"
                                           Text="PHP 0.00"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#E0E3EB"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 25 Cents Card -->
                        <Border Background="#202227" BorderBrush="#2F323A" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="25 cents (25c)"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#C5C9D3"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtCount25Centavos"
                                               Text="0 coins"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#7E838F"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="TxtValue25Centavos"
                                           Text="PHP 0.00"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#E0E3EB"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 1 Peso Card -->
                        <Border Background="#202227" BorderBrush="#2F323A" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="1 peso (PHP 1)"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#C5C9D3"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtCount1Peso"
                                               Text="0 coins"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#7E838F"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="TxtValue1Peso"
                                           Text="PHP 0.00"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#E0E3EB"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 5 Pesos Card -->
                        <Border Background="#202227" BorderBrush="#2F323A" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="5 pesos (PHP 5)"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#C5C9D3"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtCount5Pesos"
                                               Text="0 coins"
                                               FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                               Foreground="#7E838F"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="TxtValue5Pesos"
                                           Text="PHP 0.00"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#E0E3EB"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#26282E"/>

                        <!-- Total Denomination Card (Muted Navy Accent) -->
                        <Border Background="#1F2630" BorderBrush="#364557" BorderThickness="1" CornerRadius="6" Padding="16">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL DENOMINATION"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#9CAEC4"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           LetterSpacing="0.8"/>

                                <TextBlock x:Name="TxtTotalAmount"
                                           Text="PHP 0.00"
                                           FontFamily="'Playfair Display', 'Libre Baskerville', Georgia, 'Times New Roman', serif"
                                           Foreground="#F2F5F8"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="TxtTotalCount"
                                           Text="(0 coins detected)"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#78879A"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- DIP Methods Summary -->
                        <Border Background="#18191C" BorderBrush="#25262B" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Image Processing Pipeline"
                                           FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif"
                                           Foreground="#858994"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="- Otsu Adaptive Binarization" FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif" Foreground="#656973" FontSize="10"/>
                                <TextBlock Text="- 4-Connected Component BFS" FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif" Foreground="#656973" FontSize="10"/>
                                <TextBlock Text="- Spatial Centroid and Area Moments" FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif" Foreground="#656973" FontSize="10"/>
                                <TextBlock Text="- Kernel Center Hole Detection (5c)" FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif" Foreground="#656973" FontSize="10"/>
                                <TextBlock Text="- Raster Band Row Sorting" FontFamily="Inter, -apple-system, 'Segoe UI', Roboto, sans-serif" Foreground="#656973" FontSize="10"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</Window>
