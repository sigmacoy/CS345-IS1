<!-- MainWindow.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aug17.MainWindow"
        Title="Vacuum Agent" Width="800" Height="400"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30">
    
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*, *">
        
        <!-- Left Column -->
        <Button x:Name="button1" Grid.Row="0" Grid.Column="0" Content="Start Simulation" Click="button1_Click" Margin="10" />
        <TextBox Grid.Row="1" Grid.Column="0" x:Name="OutputLog" AcceptsReturn="True" 
                 IsReadOnly="True" Margin="10" TextWrapping="Wrap"/>
        
        <!-- Right Column -->
        <Button x:Name="button2" Grid.Row="0" Grid.Column="1" Content="Button 2" Margin="10" />
        <Canvas Grid.Row="1" Grid.Column="1" x:Name="SimulationCanvas" Background="White" Margin="10" />
        
    </Grid>
</Window>